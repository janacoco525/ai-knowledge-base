# AI知识库 — 环境配置模板
# 复制本文件为 .env 后填入你自己的密钥；.env 不会被提交

# ===== LLM 供应商（任选其一或多个）=====
# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Step / 其他 OpenAI 兼容端点
STEP_API_KEY=
STEP_API_BASE=
STEP_MODEL=

# ===== 数据目录 =====
# 文档扫描路径（Windows 示例，用分号分隔多个路径）
SCAN_PATHS=
DATA_DIR=

# ===== 检索参数 =====
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K=5

# ===== Embedding（默认离线）=====
EMBEDDING_MODEL=offline
EMBEDDING_DEVICE=cpu
